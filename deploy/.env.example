# Copy to deploy/keys/writ.env, or run `writ keygen --out deploy/keys` which writes a complete file.
#
# Required secrets. Keys are base64url raw Ed25519 (32 bytes). Tokens must be >= 24 characters.
WRIT_GATE_PRIVATE_KEY=
WRIT_GATE_PUBLIC_KEY=
WRIT_EXECUTOR_PRIVATE_KEY=
WRIT_EXECUTOR_PUBLIC_KEY=
WRIT_ADMIN_TOKEN=
WRIT_INTERNAL_TOKEN=
WRIT_DEMO_SAAS_API_KEY=

# Optional: named operators (ledger records who acted). Comma separated name:token pairs.
# WRIT_ADMIN_TOKENS=alice:<token>,bob:<token>

# Optional: during key rotation, list the old and the new public key of the peer.
# WRIT_EXECUTOR_PUBLIC_KEY=<old>,<new>
# WRIT_GATE_PUBLIC_KEY=<old>,<new>

# Optional tunables (defaults shown). See docs/deploy.md.
# WRIT_AUTHORIZATION_TTL_SECONDS=60
# WRIT_MAX_TASK_TTL_SECONDS=604800
# WRIT_MAX_DELEGATION_DEPTH=8
# WRIT_MAX_TASKS_PER_TREE=256
# WRIT_MAX_BODY_BYTES=1048576
# WRIT_AGENT_RATE_LIMIT=50
# WRIT_AGENT_RATE_BURST=100
# WRIT_SWEEP_INTERVAL_SECONDS=30
# WRIT_STALE_CONSUMED_SECONDS=300
# WRIT_RECONCILE_AFTER_SECONDS=30
# WRIT_NONCE_RETENTION_DAYS=30
# WRIT_ENABLE_DOCS=0
# WRIT_LOG_LEVEL=INFO
